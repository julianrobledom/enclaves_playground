target Cpp;

reactor task2 {

    public preamble {=
        #include <stdlib.h>
        #include <stdio.h>
        #include "utils.h"
    =}

    input in: arr_t;
    output out: arr_t;

    reaction(in) -> out {=
        arr_t user = *in.get();
        int t3 = *(user[0]+3);
        wait(t3);
        out.set(user);
    =}
}