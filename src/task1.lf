target Cpp;

reactor task1 {

    public preamble {=
        #include <stdlib.h>
        #include <stdio.h>
        #include "utils.h"
    =}

    input in: arr_t;
    output out: arr_t;

    reaction(in) -> out {=
        arr_t user = *in.get();
        int t2 = *(user[0]+2);
        wait(t2);
        out.set(user);
    =}
}