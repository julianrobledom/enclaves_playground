target Cpp;

reactor task0 {

    public preamble {=
        #include <stdlib.h>
        #include <stdio.h>
        #include "utils.h"
    =}

    input in: arr_t;
    output out: arr_t;

    reaction(in) -> out {=
        arr_t user = *in.get();
        int t1 = *(user[0]+1);
        wait(t1);
        out.set(user);
    =}
}