target Cpp
{
    //compiler: gcc,
    //build-type: Debug,
    //export-dependency-graph: true,
    cmake-include: pipeline.cmake,
    build-type: Release,
    timeout: 12 s,
}

import dispatch_manager from "dispatcher.lf"
import task0 from "task0.lf";
import task1 from "task1.lf";
import task2 from "task2.lf";
import task7 from "task7.lf";

public preamble {=
    #include <stdlib.h>
    #include <stdio.h>
=}

main reactor {

    reaction(startup) {=
        std::cout << "init pipeline!\n";
    =}

    dispatch_generator = new dispatch_manager(
        num_user_threads = 5,
        num_requests = 5
    );

    // ---------------------------------------------
    // user 1
    user1_task0 = new task0();
    user1_task1 = new task1();
    user1_task2 = new task2();
    user1_task7 = new task7();

